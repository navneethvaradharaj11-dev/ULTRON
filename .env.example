# Environment Configuration Example for ULTRON

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ultron_db

# Security & Secrets
JWT_SECRET=your_32byte_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration ('gemini', 'openai', 'anthropic', or 'mock')
AI_PROVIDER=mock
AI_MODEL_NAME=gemini-2.5-flash
AI_API_KEY=your_ai_api_key_here

# Voice Configuration
VOICE_ENGINE=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock

# System Safety & Execution Limits
MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=5
MAX_CONTEXT_MESSAGES=20
TOOL_TIMEOUT=10.0
MODEL_TIMEOUT=30.0
