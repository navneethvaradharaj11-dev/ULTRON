# ULTRON PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in production server and populate secure random values.
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT.

# Server Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Security Settings (Mandatory: Replace with 32+ byte secure random secret)
JWT_SECRET=replace_with_a_32_byte_secure_random_production_jwt_secret_key!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Production Settings
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ultron_user
MYSQL_PASSWORD=replace_with_strong_production_database_password
MYSQL_DATABASE=ultron_db

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password_if_configured
REDIS_DB=0

# AI Provider Settings ('gemini', 'openai', 'anthropic', or 'mock')
AI_PROVIDER=mock
AI_MODEL_NAME=gemini-2.5-flash
AI_API_KEY=mock_key

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=https://app.ultron.ai
RATE_LIMIT_PER_MINUTE=60
